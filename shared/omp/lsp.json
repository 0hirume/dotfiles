{
  "servers": {
    "instar": {
      "command": "instar",
      "args": ["server"],
      "fileTypes": [".luau"],
      "languageId": "luau",
      "rootMarkers": ["."]
    },
    "nushell": {
      "command": "nu",
      "args": ["--lsp"],
      "fileTypes": [".nu"],
      "rootMarkers": ["."]
    },
    "nu-lint": {
      "command": "nu-lint",
      "args": ["--lsp"],
      "fileTypes": [".nu"],
      "rootMarkers": ["."],
      "isLinter": true
    }
  }
}
